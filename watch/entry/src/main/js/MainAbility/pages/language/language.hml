<div class="page" style="width: {{screenWidth}}; height: {{screenHeight}};" onswipe="onSwipe">
    <div class="head" style="width: {{headWidth}}; margin-top: {{headTop}};">
        <div class="back" onclick="goBack">
            <text class="back-text">{{backGlyph}}</text>
        </div>
        <text class="title" style="width: {{titleWidth}};">{{title}}</text>
    </div>
    <list class="list" ref="list" style="width: {{contentWidth}}; height: {{listHeight}};">
        <list-item class="item" style="width: {{contentWidth}};" onclick="pick0">
            <text class="name" style="width: {{nameWidth}}; color: {{option0Color}};">{{option0Name}}</text>
            <text class="sub" style="width: {{subWidth}};">{{option0Sub}}</text>
            <div class="dot" show="{{option0Selected}}"></div>
        </list-item>
        <list-item class="item" style="width: {{contentWidth}};" onclick="pick1">
            <text class="name" style="width: {{nameWidth}}; color: {{option1Color}};">{{option1Name}}</text>
            <text class="sub" style="width: {{subWidth}};"></text>
            <div class="dot" show="{{option1Selected}}"></div>
        </list-item>
        <list-item class="item" style="width: {{contentWidth}};" onclick="pick2">
            <text class="name" style="width: {{nameWidth}}; color: {{option2Color}};">{{option2Name}}</text>
            <text class="sub" style="width: {{subWidth}};"></text>
            <div class="dot" show="{{option2Selected}}"></div>
        </list-item>
        <list-item class="item" style="width: {{contentWidth}};" onclick="pick3">
            <text class="name" style="width: {{nameWidth}}; color: {{option3Color}};">{{option3Name}}</text>
            <text class="sub" style="width: {{subWidth}};"></text>
            <div class="dot" show="{{option3Selected}}"></div>
        </list-item>
        <list-item class="item" style="width: {{contentWidth}};" onclick="pick4">
            <text class="name" style="width: {{nameWidth}}; color: {{option4Color}};">{{option4Name}}</text>
            <text class="sub" style="width: {{subWidth}};"></text>
            <div class="dot" show="{{option4Selected}}"></div>
        </list-item>
        <list-item class="item" style="width: {{contentWidth}};" onclick="pick5">
            <text class="name" style="width: {{nameWidth}}; color: {{option5Color}};">{{option5Name}}</text>
            <text class="sub" style="width: {{subWidth}};"></text>
            <div class="dot" show="{{option5Selected}}"></div>
        </list-item>
        <list-item class="item" style="width: {{contentWidth}};" onclick="pick6">
            <text class="name" style="width: {{nameWidth}}; color: {{option6Color}};">{{option6Name}}</text>
            <text class="sub" style="width: {{subWidth}};"></text>
            <div class="dot" show="{{option6Selected}}"></div>
        </list-item>
    </list>
</div>
