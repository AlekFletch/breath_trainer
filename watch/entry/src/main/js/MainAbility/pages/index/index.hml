<div class="page" style="width: {{screenWidth}}; height: {{screenHeight}};" onswipe="onSwipe">
    <div class="layout" show="{{rect}}">
        <div class="row">
            <div class="btn" onclick="openSettings">
                <text class="btn-text">{{settingsLabel}}</text>
            </div>
            <div class="btn" onclick="toggleVibration">
                <text class="btn-text">{{vibrationLabel}}</text>
            </div>
        </div>
        <div class="grid-row">
            <div class="card" style="border-color: {{card0Border}};" onclick="pick0">
                <text class="card-title">{{card0Name}}</text>
                <text class="card-sub">{{card0Phases}}</text>
            </div>
            <div class="card" style="border-color: {{card1Border}};" onclick="pick1">
                <text class="card-title">{{card1Name}}</text>
                <text class="card-sub">{{card1Phases}}</text>
            </div>
        </div>
        <div class="grid-row">
            <div class="card" style="border-color: {{card2Border}};" onclick="pick2">
                <text class="card-title">{{card2Name}}</text>
                <text class="card-sub">{{card2Phases}}</text>
            </div>
            <div class="card" style="border-color: {{card3Border}};" onclick="pick3">
                <text class="card-title">{{card3Name}}</text>
                <text class="card-sub">{{card3Phases}}</text>
            </div>
        </div>
        <div class="start" onclick="start">
            <text class="start-text">{{startLabel}}</text>
        </div>
    </div>
    <div class="r-layout" show="{{round}}">
        <div class="r-row">
            <div class="r-btn" onclick="openSettings">
                <text class="r-btn-text">{{settingsLabel}}</text>
            </div>
            <div class="r-btn" onclick="toggleVibration">
                <text class="r-btn-text">{{vibrationLabel}}</text>
            </div>
        </div>
        <div class="r-grid-row">
            <div class="r-card" style="border-color: {{card0Border}};" onclick="pick0">
                <text class="r-card-title">{{card0Name}}</text>
                <text class="r-card-sub">{{card0Phases}}</text>
            </div>
            <div class="r-card" style="border-color: {{card1Border}};" onclick="pick1">
                <text class="r-card-title">{{card1Name}}</text>
                <text class="r-card-sub">{{card1Phases}}</text>
            </div>
        </div>
        <div class="r-grid-row">
            <div class="r-card" style="border-color: {{card2Border}};" onclick="pick2">
                <text class="r-card-title">{{card2Name}}</text>
                <text class="r-card-sub">{{card2Phases}}</text>
            </div>
            <div class="r-card" style="border-color: {{card3Border}};" onclick="pick3">
                <text class="r-card-title">{{card3Name}}</text>
                <text class="r-card-sub">{{card3Phases}}</text>
            </div>
        </div>
        <div class="r-start" onclick="start">
            <text class="r-start-text">{{startLabel}}</text>
        </div>
    </div>
</div>
